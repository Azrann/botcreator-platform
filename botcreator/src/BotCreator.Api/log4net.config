<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <root>
    <level value="ALL" />
    <appender-ref ref="rollingFile" />
    <appender-ref ref="RemoteSyslogAppender" />
  </root>
  <appender name="rollingFile" type="log4net.Appender.RollingFileAppender,log4net">
    <param name="File" type="" value="App_Data\logs\" />
    <param name="AppendToFile" value="true" />
    <param name="RollingStyle" value="Date" />
    <param name="DatePattern" value="yyyyMMdd'.txt'" />
    <param name="StaticLogFileName" value="false" />
    <param name="ImmediateFlush" value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout,log4net">
      <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n" />
    </layout>
  </appender>
  <appender name="RemoteSyslogAppender" type="log4net.Appender.RemoteSyslogAppender">
    <RemoteAddress value="logsene-receiver-syslog.sematext.com" />
    <RemotePort value="514" />
    <Identity value="27664e33-f8b0-4b2c-8a48-cb499d5cb453" />
    <layout type="BotCreator.Api.Logs.CustomPatternLayout, BotCreator.Api">
      <conversionPattern value="@cee: {&quot;feature&quot;:&quot;%property{feature}&quot; ,&quot;Environment&quot;:&quot;%property{Environment}&quot;, &quot;message&quot;:&quot;%encodedmessage&quot;}" />
    </layout>
  </appender>
</log4net>