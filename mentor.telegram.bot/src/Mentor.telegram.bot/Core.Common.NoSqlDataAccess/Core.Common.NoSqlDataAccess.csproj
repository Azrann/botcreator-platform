    <PackageReference Include="Newtonsoft.Json" Version="12.0.2" />
    <PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if $(ConfigurationName) == Release goto :exit&#xD;&#xA;cd $(ProjectDir)&#xD;&#xA;copy /y bin\Debug\netcoreapp2.2\*.dll ..\Mentor.telegram.bot.sdk\dlls&#xD;&#xA;copy /y bin\Debug\netcoreapp2.2\*.pdb ..\Mentor.telegram.bot.sdk\dlls&#xD;&#xA; :exit" />
  </Target>

</Project>
