  <ItemGroup>
    <ProjectReference Include="..\Bot.Configuration\Bot.Configuration.csproj" />
    <ProjectReference Include="..\Mentor.telegram.client\Mentor.telegram.client.csproj" Version="1.2.*" />
    <ProjectReference Include="..\Mentor.telegram.shared\Mentor.telegram.shared.csproj" Version="1.2.*" />
