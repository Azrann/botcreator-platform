<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netcoreapp2.2</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <None Remove="dlls\Bot.Configuration.dll" />
    <None Remove="dlls\Bot.telegram.funnel.dll" />
    <None Remove="dlls\Core.Common.dll" />
    <None Remove="dlls\Core.Common.NoSqlDataAccess.dll" />
    <None Remove="dlls\Core.Common.SqlDataAccess.dll" />
    <None Remove="dlls\Crypto.Core.Exchanges.dll" />
    <None Remove="dlls\Mentor.bot.boundedContext.dll" />
    <None Remove="dlls\Mentor.telegram.bot.api.services.dll" />
    <None Remove="dlls\Mentor.telegram.bot.models.dll" />
    <None Remove="dlls\Mentor.telegram.client.dll" />
    <None Remove="dlls\Mentor.telegram.coinpayments.dll" />
    <None Remove="dlls\Mentor.telegram.paypalpayments.dll" />
    <None Remove="dlls\Mentor.telegram.shared.dll" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="dlls\Bot.Configuration.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Bot.telegram.funnel.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Core.Common.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Core.Common.NoSqlDataAccess.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Core.Common.SqlDataAccess.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Crypto.Core.Exchanges.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Mentor.bot.boundedContext.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Mentor.telegram.bot.api.services.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Mentor.telegram.bot.models.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Mentor.telegram.client.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Mentor.telegram.coinpayments.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Mentor.telegram.paypalpayments.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
    <Content Include="dlls\Mentor.telegram.shared.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)</PackagePath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="9.0.0" />
    <PackageReference Include="Core.Common" Version="1.2.4" />
    <PackageReference Include="Core.Common.NoSqlDataAccess" Version="1.2.2" />
    <PackageReference Include="Dapper" Version="1.60.6" />
    <PackageReference Include="log4net" Version="2.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="3.1.2">
      <IncludeAssets>all</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="3.1.2"> 
      <IncludeAssets>all</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="3.1.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="3.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Bot.Configuration">
      <HintPath>dlls\Bot.Configuration.dll</HintPath>
    </Reference>
    <Reference Include="Bot.telegram.funnel">
      <HintPath>dlls\Bot.telegram.funnel.dll</HintPath>
    </Reference>
    <Reference Include="Core.Common.SqlDataAccess">
      <HintPath>dlls\Core.Common.SqlDataAccess.dll</HintPath>
    </Reference>
    <Reference Include="Mentor.bot.boundedContext">
      <HintPath>dlls\Mentor.bot.boundedContext.dll</HintPath>
    </Reference>
    <Reference Include="Mentor.telegram.bot.api.services">
      <HintPath>dlls\Mentor.telegram.bot.api.services.dll</HintPath>
    </Reference>
    <Reference Include="Mentor.telegram.bot.models">
      <HintPath>dlls\Mentor.telegram.bot.models.dll</HintPath>
    </Reference>
    <Reference Include="Mentor.telegram.coinpayments">
      <HintPath>dlls\Mentor.telegram.coinpayments.dll</HintPath>
    </Reference>
    <Reference Include="Mentor.telegram.paypalpayments">
      <HintPath>dlls\Mentor.telegram.paypalpayments.dll</HintPath>
    </Reference>
    <Reference Include="Mentor.telegram.shared">
      <HintPath>dlls\Mentor.telegram.shared.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
